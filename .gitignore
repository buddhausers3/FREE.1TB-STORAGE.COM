<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fun Quiz</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #f0f0f0;
      margin: 0;
      padding: 20px;
    }
    h1 {
      color: #333;
    }
    #jumpscare {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: black;
      color: white;
      font-size: 3em;
      text-align: center;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }
    img {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>
  <h1>Welcome to the Fun Quiz!</h1>
  <p>Click the button below to begin the quiz. 😊</p>
  <button onclick="startQuiz()">Start Quiz</button>

  <!-- Jumpscare Div -->
  <div id="jumpscare">
    <img src="https://imgur.com/a/LaHwuBA" alt="Scary Image">
    <p>BOO! 👻</p>
  </div>

  <script>
    function startQuiz() {
      // Delay before jumpscare (3 seconds)
      setTimeout(() => {
        // Show the jumpscare
        document.getElementById("jumpscare").style.display = "flex";

        // Play the scream sound
        const audio = new Audio("YOUR_AUDIO_URL");
        audio.play();
      }, 3000); // Adjust time (in milliseconds) as needed
    }
  </script>
</body>
</html>